# Environment variables for Ratonobot project
# Copy this file to .env and replace placeholders with actual values
# Do not commit .env to version control

# Discord Bot Configuration
# Required: Token for the Discord bot to authenticate and connect to Discord API
DISCORD_TOKEN=your_discord_bot_token_here

# Server Configuration
# Optional: Port for the HTTP server (default: 3000 if not set)
PORT=3000

# AI Provider Configuration
# Required for CrofAI: API key to access the CrofAI service
CROFAI_API_KEY=your_crofai_api_key_here

# MCP Configuration
# Optional: Environment variables for MCP servers can be defined in mcp_config.json per server
# Example for a server requiring an API key: Add "env": {"API_KEY": "value"} in mcp_config.json